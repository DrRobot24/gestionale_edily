# Stesso progetto Supabase di wbs-office: Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_APP_NAME=ENCREADE Gestionale

# ── Muro "Lavori in corso" ────────────────────────────────────────────
# `true` mette davanti a tutto il cartello di attesa: i clienti che hanno
# l'URL non vedono le novita' finche' non sono pronte. Qualsiasi altro
# valore (riga assente compresa) lascia l'app aperta.
# Non e' sicurezza — finisce nel bundle come ogni VITE_*. A proteggere i
# dati resta la RLS.
VITE_WIP=false
# Chi passa il muro comunque: email separate da virgola. Serve il login,
# perche' e' da li' che si sa chi sei.
VITE_WIP_EMAIL_AMMESSE=tua@email.it
